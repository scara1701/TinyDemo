<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="100"
             xmlns:local="clr-namespace:TinyDemo.AvaloniaClient.Controls"
             x:DataType="local:NumberControl"
             Width="100" Height="100"
             x:Class="TinyDemo.AvaloniaClient.Controls.NumberControl">
    
    <Grid>
        <Ellipse Fill="LightBlue" Stroke="Black"/>
        <TextBlock Text="{Binding Number, RelativeSource={RelativeSource AncestorType=local:NumberControl}}"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

    </Grid>
</UserControl>
